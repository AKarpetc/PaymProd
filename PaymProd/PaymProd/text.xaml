<Window x:Class="PaymProd.text"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заметки" Height="200" Width="300" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen" >
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="19*"/>
            <RowDefinition Height="123*"/>
            <RowDefinition Height="27*"/>
        </Grid.RowDefinitions>
        <TextBlock Margin="5,0,0,0">Заметки к данному компоненту бдюда:</TextBlock>
        <TextBox Margin="5" BorderBrush="Black" Name="text1" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" Grid.Row="1"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38*"/>
                <ColumnDefinition Width="72*"/>
                <ColumnDefinition Width="77*"/>
                <ColumnDefinition Width="72*"/>
                <ColumnDefinition Width="33*"/>
            </Grid.ColumnDefinitions>
            <Button Margin="3" Grid.Column="1" Click="Button_Click_1">Отмена</Button>
            <Button Margin="3" Grid.Column="3" Click="Button_Click">Ок</Button>
        </Grid>
    </Grid>
</Window>
