<Application x:Class="PaymProdNet9.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:PaymProdNet9.Converters"
             StartupUri="MainNavigationWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Material Design -->
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Blue" SecondaryColor="Amber" />
                <ResourceDictionary
                    Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Стиль для общего фона -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="AntiqueWhite" />

            <!-- Converters -->
            <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <!-- Стили для кнопок в таблицах -->
            <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                <Setter Property="Foreground" Value="#F44336" />
                <Setter Property="ToolTip" Value="Удалить" />
                <Setter Property="Margin" Value="5,0" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FFEBEE" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="EditButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
                <Setter Property="Foreground" Value="#2196F3" />
                <Setter Property="ToolTip" Value="Редактировать" />
                <Setter Property="Margin" Value="5,0" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#E3F2FD" />
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>