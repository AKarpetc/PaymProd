<Window x:Class="PaymProdNet9.Windows.UpdateDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Загрузка обновления"
        Height="180"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTextBlock"
                   Text="Скачивание обновления"
                   FontSize="16"
                   FontWeight="SemiBold" />

        <TextBlock x:Name="VersionTextBlock"
                   Grid.Row="1"
                   Margin="0,8,0,0"
                   FontSize="13"
                   Foreground="Gray" />

        <ProgressBar x:Name="DownloadProgressBar"
                     Grid.Row="2"
                     Margin="0,15,0,0"
                     Height="22"
                     Minimum="0"
                     Maximum="100"
                     IsIndeterminate="True" />

        <TextBlock x:Name="DetailsTextBlock"
                   Grid.Row="3"
                   Margin="0,8,0,0"
                   FontSize="12"
                   Foreground="Gray"
                   Text="Подготовка к загрузке..." />
    </Grid>
</Window>