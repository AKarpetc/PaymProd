<Window x:Class="PaymProdNet9.Windows.PrintFullMenuConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Настройка отчета по всему меню" Height="500" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Выберите типы блюд:" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
        
        <ListBox x:Name="CategoriesListBox" Grid.Row="1" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#ccc" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <Button Content="Выбрать все" Click="SelectAll_Click" Margin="0,0,10,0" Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Content="Убрать все" Click="UnselectAll_Click" Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </StackPanel>
        
        <GroupBox Grid.Row="3" Header="Дополнительные колонки" Style="{StaticResource MaterialDesignCardGroupBox}" Margin="0,0,0,15">
            <StackPanel>
                <CheckBox Content="Блюдо" IsChecked="True" IsEnabled="False" Margin="0,5"/>
                <CheckBox Content="Состав" IsChecked="True" IsEnabled="False" Margin="0,5"/>
                <CheckBox x:Name="CostCheckBox" Content="Себестоимость порции" Margin="0,5"/>
                <CheckBox x:Name="PriceCheckBox" Content="Цена порции" Margin="0,5"/>
            </StackPanel>
        </GroupBox>
        
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Click="Cancel_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,10,0"/>
            <Button Content="Сформировать" Click="Generate_Click" Style="{StaticResource MaterialDesignRaisedButton}" Background="#4CAF50" BorderBrush="#4CAF50" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
