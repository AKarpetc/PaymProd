<Window x:Class="PaymProdNet9.Windows.GoogleDriveAuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Авторизация Google Drive"
        Height="400"
        Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Настройка автоматической загрузки на Google Drive"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15"
                   TextWrapping="Wrap"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Для автоматической загрузки файлов на Google Drive необходим OAuth токен."
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Инструкция:"
                           FontWeight="Bold"
                           Margin="0,10,0,5"/>

                <TextBlock Text="1. Откройте ссылку ниже в браузере"
                           Margin="0,0,0,5"/>
                <TextBlock Text="2. Авторизуйтесь в Google"
                           Margin="0,0,0,5"/>
                <TextBlock Text="3. Скопируйте полученный токен"
                           Margin="0,0,0,5"/>
                <TextBlock Text="4. Вставьте токен в поле ниже"
                           Margin="0,0,0,15"/>

                <Button Name="OpenAuthLinkButton"
                        Content="🔗 Открыть ссылку для получения токена"
                        Click="OpenAuthLinkButton_Click"
                        Margin="0,0,0,15"
                        Padding="10,8"/>

                <TextBlock Text="OAuth токен:"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBox Name="TokenTextBox"
                         materialDesign:HintAssist.Hint="Вставьте токен сюда"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         MinHeight="80"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,10"/>

                <TextBlock Text="⚠️ Токен будет сохранен локально для автоматических загрузок."
                           Foreground="Orange"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Margin="0,0,0,10"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Отмена"
                    Click="CancelButton_Click"
                    Margin="0,0,10,0"
                    Padding="20,8"/>
            <Button Content="Сохранить токен"
                    Click="SaveTokenButton_Click"
                    Padding="20,8"/>
        </StackPanel>
    </Grid>
</Window>

