<Window x:Class="PaymProdNet9.Windows.DelicateInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://schemas.materialdesigninxaml.net/winfx/xaml/themes"
        Title="Состав блюда"
        Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="DelicateNameTextBlock"
                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                   FontWeight="Bold"
                   Margin="0,0,0,15"
                   TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="CompositionTextBlock"
                       Style="{StaticResource MaterialDesignBody1TextBlock}"
                       TextWrapping="Wrap" />
        </ScrollViewer>

        <Button Grid.Row="2" Content="Закрыть"
                Style="{StaticResource MaterialDesignRaisedButton}"
                HorizontalAlignment="Right"
                Margin="0,15,0,0"
                Click="CloseButton_Click"
                Width="100" />
    </Grid>
</Window>

