<Page x:Class="PaymProdNet9.Pages.ParametersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Параметры"
      Background="#F5F5F5">

    <Page.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="15,8" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="#f44336" />
            <Setter Property="BorderBrush" Value="#f44336" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="InfoButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="#2196F3" />
            <Setter Property="BorderBrush" Value="#2196F3" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <TabControl Style="{StaticResource MaterialDesignTabControl}" materialDesign:ColorZoneAssist.Mode="PrimaryMid">
            <!-- Вкладка База данных -->
            <TabItem Header="База данных">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <TextBlock Grid.Row="0"
                               Text="Управление базой данных"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,0,0,20" />

                    <!-- Основные операции -->
                    <GroupBox Grid.Row="1" Header="Операции с базой данных" Padding="10" Margin="0,0,0,15">
                        <StackPanel>
                            <!-- Текущая база -->
                            <TextBlock Text="Текущая база данных:" FontWeight="Bold" Margin="0,0,0,5" />
                            <TextBlock Name="CurrentDbPathText"
                                       Text="Загрузка..."
                                       TextWrapping="Wrap"
                                       Foreground="DarkBlue"
                                       Margin="0,0,0,15" />

                            <!-- Кнопки операций -->
                            <WrapPanel HorizontalAlignment="Center">
                                <Button Name="ExportButton"
                                        Content="💾 Экспорт базы данных"
                                        Click="ExportButton_Click"
                                        ToolTip="Сохранить копию базы данных в выбранную папку" />

                                <Button Name="ImportButton"
                                        Content="📂 Импорт базы данных"
                                        Style="{StaticResource InfoButton}"
                                        Click="ImportButton_Click"
                                        ToolTip="Загрузить базу данных из файла" />

                                <Button Name="AutoBackupButton"
                                        Content="🔄 Создать резервную копию"
                                        Click="AutoBackupButton_Click"
                                        ToolTip="Создать автоматическую резервную копию" />

                                <Button Name="ShareLogsToS3Button"
                                        Content="☁️ Поделиться журналом ошибок"
                                        Style="{StaticResource InfoButton}"
                                        Click="ShareLogsToS3Button_Click"
                                        ToolTip="Загрузить последний лог-файл в облачное хранилище" />
            
                                <Button Name="ShareDbToS3Button"
                                        Content="☁️ Поделиться базой данных"
                                        Style="{StaticResource InfoButton}"
                                        Click="ShareDbToS3Button_Click"
                                        ToolTip="Загрузить текущую базу данных в облачное хранилище" />
            
                                <Button Name="ResetDbButton"
                                        Content="🆕 Начать с новой базы"
                                        Style="{StaticResource DangerButton}"
                                        Click="ResetDbButton_Click"
                                        ToolTip="Создать пустую базу данных (текущая будет удалена)" />
            
                                <Button Name="DownloadStartDbButton"
                                        Content="⬇️ Скачать стартовую базу"
                                        Style="{StaticResource InfoButton}"
                                        Click="DownloadStartDbButton_Click"
                                        ToolTip="Заменить текущую базу подготовленными данными" />
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Список резервных копий -->
                    <GroupBox Grid.Row="2" Header="Доступные резервные копии" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Список -->
                            <DataGrid Name="BackupsDataGrid"
                                      Grid.Row="0"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      AlternatingRowBackground="#F9F9F9"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Имя файла" Binding="{Binding FileName}" Width="*" />
                                    <DataGridTextColumn Header="Дата создания" Binding="{Binding FormattedDate}" Width="150" />
                                    <DataGridTextColumn Header="Размер" Binding="{Binding FormattedSize}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Кнопки управления резервными копиями -->
                            <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button Name="RefreshButton"
                                        Content="🔄 Обновить список"
                                        Style="{StaticResource InfoButton}"
                                        Click="RefreshButton_Click" />

                                <Button Name="RestoreButton"
                                        Content="↩️ Восстановить выбранную"
                                        Style="{StaticResource DangerButton}"
                                        Click="RestoreButton_Click"
                                        IsEnabled="{Binding ElementName=BackupsDataGrid, Path=SelectedItem, Converter={StaticResource NullToBoolConverter}}" />

                                <Button Name="OpenFolderButton"
                                        Content="📁 Открыть папку с копиями"
                                        Style="{StaticResource InfoButton}"
                                        Click="OpenFolderButton_Click" />
                            </WrapPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Вкладка Настройки -->
            <TabItem Header="Настройки">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Общие настройки"
                               FontSize="24"
                               FontWeight="Bold"
                               Margin="0,0,0,20" />

                    <StackPanel Grid.Row="1">
                        <GroupBox Header="Параметры по умолчанию" Padding="10" Margin="0,0,0,15">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="250" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Процент за обслуживание (%):" VerticalAlignment="Center" FontSize="14" />
                                    <TextBox Grid.Column="1" x:Name="ServicePercentTextBox" 
                                             Width="100" HorizontalAlignment="Left"
                                             PreviewTextInput="NumericTextBox_PreviewTextInput" 
                                             LostFocus="ValidateNumeric_LostFocus" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="250" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Надбавка по умолчанию (%):" VerticalAlignment="Center" FontSize="14" />
                                    <TextBox Grid.Column="1" x:Name="DefaultMarkupTextBox" 
                                             Width="100" HorizontalAlignment="Left"
                                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                                             LostFocus="ValidateNumeric_LostFocus"
                                             ToolTip="Значение надбавки, которое будет использоваться для новых блюд" />

                                    <Button Grid.Column="1" 
                                            Content="Применить ко всем блюдам" 
                                            HorizontalAlignment="Right" 
                                            Margin="120,0,0,0"
                                            Style="{StaticResource InfoButton}"
                                            Click="ApplyMarkupToAll_Click"
                                            ToolTip="Применить эту надбавку ко всем блюдам в справочнике и в текущем меню" />
                                </Grid>
                                
                                <Button Content="Сохранить настройки" HorizontalAlignment="Left" Click="SaveSettings_Click" Margin="0,10,0,0" />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Настройки отображения" Padding="10">
                            <StackPanel>
                                <CheckBox x:Name="ShowDeletedItemsCheckBox"
                                          Content="Показывать удалённые элементы в справочниках"
                                          Margin="0,0,0,5"
                                          ToolTip="Если включено, в справочниках продуктов и блюд будут отображаться элементы, помеченные как удалённые."
                                          Checked="ShowDeletedItemsCheckBox_Changed"
                                          Unchecked="ShowDeletedItemsCheckBox_Changed" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
