<Page x:Class="PaymProdNet9.Pages.CurrentMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Title="Текущее меню"
      Loaded="Page_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Панель быстрых действий -->
        <materialDesign:Card Grid.Row="0" Margin="10" Padding="10">
            <WrapPanel HorizontalAlignment="Center">
                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="SaveMenuChanges_Click" Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="Сохранить изменения" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="RefreshMenu_Click" Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="Обновить" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </materialDesign:Card>

        <!-- Основной контент -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- БЛОК 1: Информация о банкете (ВВЕРХУ) -->
            <materialDesign:Card Grid.Row="0" Margin="10" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Название банкета:"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" x:Name="BanquetNameTextBox"
                             materialDesign:HintAssist.Hint="Введите название"
                             LostFocus="BanquetInfo_LostFocus" Margin="0,0,20,0" />

                    <TextBlock Grid.Column="2" Text="Количество человек:"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="3" x:Name="PeopleCountTextBox"
                             materialDesign:HintAssist.Hint="Кол-во"
                             PreviewTextInput="NumericTextBox_PreviewTextInput"
                             LostFocus="BanquetInfo_LostFocus" Margin="0,0,20,0" />

                    <TextBlock Grid.Column="4" Text="Дата, начало:"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <DatePicker Grid.Column="5" x:Name="BanquetDatePicker"
                                SelectedDateChanged="BanquetInfo_Changed" Margin="0,0,20,0" />

                    <TextBlock Grid.Column="6" Text="Описание:"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="7" x:Name="DescriptionTextBox"
                             materialDesign:HintAssist.Hint="Краткое описание"
                             LostFocus="BanquetInfo_LostFocus" Margin="0,0,10,0" />

                    <StackPanel Grid.Column="8" Orientation="Horizontal">
                        <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                Click="StartMenu_Click"
                                ToolTip="Перейти к заполнению"
                                Margin="0,0,5,0">
                            <materialDesign:PackIcon Kind="PlayCircle" />
                        </Button>
                        <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                Click="NewMenu_Click"
                                ToolTip="Новое меню">
                            <materialDesign:PackIcon Kind="Plus" />
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch"
                          Background="Gray" Height="5" />

            <!-- БЛОК 2: Доступные блюда (СЕРЕДИНА - равная высота) -->
            <materialDesign:Card Grid.Row="2" Margin="10" Padding="10">
                <Grid x:Name="DelicatesPanel" IsEnabled="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Фильтр по типам блюд -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="AllTypesButton" Content="Все"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Click="FilterDelicates_Click" Tag="%" Margin="0,0,5,0" />
                    </StackPanel>

                    <!-- Список доступных блюд -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AvailableDelicatesPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card Margin="5" Width="300"
                                                         MouseDoubleClick="DelicateCard_MouseDoubleClick">
                                        <Grid Margin="10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Text="{Binding Del}"
                                                       FontWeight="Bold" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="1" Text="{Binding Sost}"
                                                       TextWrapping="Wrap" Opacity="0.7" Margin="0,5,0,5" />
                                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                <TextBox x:Name="QuantityTextBox"
                                                         Width="80"
                                                         materialDesign:HintAssist.Hint="Кол-во"
                                                         PreviewTextInput="NumericTextBox_PreviewTextInput"
                                                         TextChanged="QuantityTextBox_TextChanged"
                                                         Tag="{Binding}" />
                                                <TextBlock VerticalAlignment="Center" Margin="5,0,0,0"
                                                           Text="{Binding WeightInfo}" />
                                                <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                        Click="AddDelicateToMenu_Click"
                                                        Tag="{Binding}"
                                                        Margin="10,0,0,0"
                                                        ToolTip="Добавить в меню"
                                                        IsEnabled="False"
                                                        x:Name="AddButton">
                                                    <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>

            <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch"
                          Background="Gray" Height="5" />

            <!-- БЛОК 3: Список блюд в меню (ВНИЗУ - равная высота) -->
            <materialDesign:Card Grid.Row="4" Margin="10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="CurrentMenuInfo"
                               Text="Выберите или создайте новое меню"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Margin="0,0,0,10" />

                    <DataGrid Grid.Row="1" x:Name="MenuDelicatesDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              IsReadOnly="False"
                              materialDesign:DataGridAssist.CellPadding="10"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="10">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource EditButtonStyle}"
                                                Click="EditDelicateInMenu_Click"
                                                Width="24"
                                                Height="24"
                                                ToolTip="Редактировать блюдо">
                                            <materialDesign:PackIcon Kind="Pencil"
                                                                     Width="14"
                                                                     Height="14" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource DeleteButtonStyle}"
                                                Click="DeleteDelicateFromMenu_Click"
                                                Width="24"
                                                Height="24"
                                                ToolTip="Удалить блюдо">
                                            <materialDesign:PackIcon Kind="Delete"
                                                                     Width="14"
                                                                     Height="14" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="40" Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <materialDesign:PackIcon Kind="AlertCircle"
                                                                 Width="16"
                                                                 Height="16"
                                                                 Foreground="Orange"
                                                                 Visibility="{Binding IsModified, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                 ToolTip="Блюдо изменено в этом меню" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Блюдо" Binding="{Binding Del}"
                                                Width="2*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Состав" Binding="{Binding Sost}"
                                                Width="3*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Количество" Binding="{Binding Countpor}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Панель редактирования блюда в меню -->
        <Grid x:Name="EditDelicateInMenuPanel" Grid.RowSpan="2"
              Background="#80000000" Visibility="Collapsed">
            <materialDesign:Card Width="900" MaxHeight="800"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="EditDelicateTitle"
                               Text="Редактирование блюда в меню"
                               Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                               Margin="0,0,0,15" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Название блюда:"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Margin="0,0,0,10" />
                            <TextBlock x:Name="EditDelicateNameText"
                                       Style="{StaticResource MaterialDesignBody1TextBlock}"
                                       Margin="0,0,0,20" />

                            <TextBlock Text="Состав блюда (можно изменить):"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Margin="0,0,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <GroupBox Grid.Column="0" Header="Доступные продукты" Margin="0,0,10,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBox Grid.Row="0" x:Name="EditProductSearchBox"
                                                 materialDesign:HintAssist.Hint="Поиск..."
                                                 TextChanged="EditProductSearch_TextChanged"
                                                 Margin="0,0,0,5" />
                                        <ListBox Grid.Row="1" x:Name="EditAvailableProductsList"
                                                 DisplayMemberPath="Name"
                                                 SelectionMode="Single"
                                                 MaxHeight="300" />
                                    </Grid>
                                </GroupBox>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                            Click="AddProductToEditDelicate_Click"
                                            Margin="0,0,0,10"
                                            ToolTip="Добавить в состав">
                                        <materialDesign:PackIcon Kind="ArrowRight" />
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                            Click="RemoveProductFromEditDelicate_Click"
                                            ToolTip="Убрать из состава">
                                        <materialDesign:PackIcon Kind="ArrowLeft" />
                                    </Button>
                                </StackPanel>

                                <GroupBox Grid.Column="2" Header="Состав блюда" Margin="10,0,0,0">
                                    <DataGrid x:Name="EditDelicateComponentsGrid"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              materialDesign:DataGridAssist.CellPadding="5"
                                              MaxHeight="300">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Продукт" Binding="{Binding NameT}" Width="*"
                                                                IsReadOnly="True" />
                                            <DataGridTextColumn Header="Вес" Binding="{Binding Ves}" Width="80" />
                                            <DataGridTextColumn Header="Мера" Binding="{Binding Mera}" Width="60"
                                                                IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </GroupBox>
                            </Grid>

                            <TextBlock
                                Text="⚠️ Внимание: Изменения применяются только к этому меню и не влияют на справочник блюд."
                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                Foreground="Orange"
                                Margin="0,15,0,0"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="❌ Отмена"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="CancelEditDelicateInMenu_Click"
                                Margin="0,0,15,0"
                                Padding="30,15"
                                FontSize="15"
                                FontWeight="SemiBold"
                                MinHeight="50"
                                MinWidth="150" />
                        <Button Content="💾 Сохранить изменения"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Click="SaveEditDelicateInMenu_Click"
                                Background="#4CAF50"
                                Padding="30,15"
                                FontSize="15"
                                FontWeight="SemiBold"
                                MinHeight="50"
                                MinWidth="200" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Индикатор загрузки -->
        <Grid x:Name="LoadingOverlay" Grid.RowSpan="2"
              Background="#80000000" Visibility="Collapsed">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         Value="0" IsIndeterminate="True"
                         Width="100" Height="100" />
        </Grid>
    </Grid>
</Page>