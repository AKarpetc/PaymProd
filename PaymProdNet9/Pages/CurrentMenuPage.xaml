<Page x:Class="PaymProdNet9.Pages.CurrentMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      Title="Текущее меню"
      Loaded="Page_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Панель быстрых действий -->
        <materialDesign:Card Grid.Row="0" Margin="10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Кнопки действий -->
                <WrapPanel Grid.Column="0" HorizontalAlignment="Left" Margin="0,0,15,0">
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="RefreshMenu_Click" Margin="5"
                            ToolTip="Обновить">
                        <materialDesign:PackIcon Kind="Refresh" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="EnterMenuPrices_Click" Margin="5"
                            ToolTip="Ввести цены для меню">
                        <materialDesign:PackIcon Kind="CurrencyUsd" />
                    </Button>
                    <CheckBox x:Name="ShowHiddenItemsCheckBox"
                              Margin="10,5,5,5"
                              VerticalAlignment="Center"
                              IsChecked="True"
                              Checked="ShowHiddenItemsCheckBox_Changed"
                              Unchecked="ShowHiddenItemsCheckBox_Changed"
                              ToolTip="Показать товары (включая позиции &quot;не показывать в меню&quot;)">
                        <TextBlock Text="Показать скрытые" />
                    </CheckBox>
                </WrapPanel>

                <!-- Поле поиска по блюдам -->
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" x:Name="DelicateSearchBox"
                             materialDesign:HintAssist.Hint="Поиск по названию блюда..."
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             VerticalAlignment="Center"
                             FontSize="14"
                             HorizontalAlignment="Stretch"
                             Margin="0,0,5,0"
                             KeyDown="DelicateSearchBox_KeyDown"
                             TextChanged="DelicateSearchBox_TextChanged" />

                    <Button Grid.Column="1" x:Name="DelicateSearchButton"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="DelicateSearchButton_Click"
                            Margin="0,0,5,0"
                            ToolTip="Найти блюдо">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="Поиск" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" x:Name="DelicateSearchClearButton"
                            Width="22"
                            Height="22"
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Click="DelicateSearchClearButton_Click"
                            Visibility="Collapsed"
                            ToolTip="Очистить поиск">
                        <materialDesign:PackIcon Kind="CloseCircle"
                                                 Width="16"
                                                 Height="16"
                                                 Foreground="#B0BEC5" />
                    </Button>
                </Grid>
            </Grid>
        </materialDesign:Card>

        <!-- Основной контент -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- БЛОК 1: Информация о банкете (ВВЕРХУ) -->
            <materialDesign:Card Grid.Row="0" Margin="10,10,10,0" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Информация о меню (отображается если меню открыто) -->
                    <StackPanel x:Name="MenuInfoPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,25,0">
                            <TextBlock Text="Банкет" Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                       Opacity="0.6" />
                            <TextBlock x:Name="BanquetNameText" Text="-" FontWeight="Bold" FontSize="16"
                                       TextTrimming="CharacterEllipsis" MaxWidth="250" />
                        </StackPanel>

                        <StackPanel Margin="0,0,25,0">
                            <TextBlock Text="Гостей" Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                       Opacity="0.6" />
                            <TextBlock x:Name="PeopleCountText" Text="0" FontWeight="Bold" FontSize="16" />
                        </StackPanel>

                        <StackPanel Margin="0,0,25,0">
                            <TextBlock Text="Дата" Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                       Opacity="0.6" />
                            <TextBlock x:Name="BanquetDateText" Text="-" FontWeight="Bold" FontSize="16" />
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="DescriptionText" Text="" FontStyle="Italic" Opacity="0.7"
                                       TextTrimming="CharacterEllipsis" MaxWidth="300" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Заглушка, если меню не выбрано -->
                    <TextBlock x:Name="NoMenuText" Text="Нет активного меню. Нажмите +, чтобы создать."
                               VerticalAlignment="Center" FontSize="16" Opacity="0.5"
                               Visibility="Collapsed" />

                    <!-- Кнопки управления -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                x:Name="EditMenuButton"
                                Click="EditMenu_Click"
                                ToolTip="Редактировать параметры меню"
                                Margin="0,0,10,0">
                            <materialDesign:PackIcon Kind="Pencil" />
                        </Button>
                        <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                x:Name="NewMenuButton"
                                Click="NewMenu_Click"
                                ToolTip="Создать новое меню">
                            <materialDesign:PackIcon Kind="Plus" />
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- БЛОК 2: Доступные блюда (СЕРЕДИНА - равная высота) -->
            <materialDesign:Card Grid.Row="1" Margin="10,5,10,0" Padding="10">
                <Grid x:Name="DelicatesPanel" IsEnabled="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Фильтр по типам блюд -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="AllTypesButton" Content="Все"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Click="FilterDelicates_Click" Tag="%" Margin="0,0,5,0" />
                    </StackPanel>

                    <!-- Список доступных блюд -->
                    <ListBox x:Name="AvailableDelicatesPanel"
                             Grid.Row="1"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             SelectionMode="Single">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <EventSetter Event="MouseDoubleClick" Handler="DelicateCard_MouseDoubleClick" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="5" Padding="6"
                                        Background="White">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="1.7*" />
                                            <ColumnDefinition Width="4.3*" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Info -->
                                        <Button Style="{StaticResource MaterialDesignIconButton}"
                                                Click="ShowDelicateInfo_Click"
                                                Tag="{Binding}"
                                                ToolTip="Показать полный состав"
                                                Width="28" Height="28" Padding="2"
                                                Margin="0,0,8,0">
                                            <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" />
                                        </Button>

                                        <!-- Название -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Del}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />

                                        <!-- Состав -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Sost}"
                                                   Opacity="0.8"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,2,0" />

                                        <!-- Кол-во -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                    HorizontalAlignment="Right">
                                            <TextBox x:Name="QuantityTextBox"
                                                     Width="80"
                                                     Height="28"
                                                     materialDesign:HintAssist.Hint="Кол-во"
                                                     PreviewTextInput="NumericTextBox_PreviewTextInput"
                                                     TextChanged="QuantityTextBox_TextChanged"
                                                     Loaded="QuantityTextBox_Loaded"
                                                     Tag="{Binding}"
                                                     FontSize="11" />
                                            <Button Style="{StaticResource MaterialDesignIconButton}"
                                                    Click="AddDelicateToMenu_Click"
                                                    Tag="{Binding}"
                                                    ToolTip="Добавить в меню"
                                                    Width="28" Height="28" Padding="2"
                                                    x:Name="AddButton">
                                                <materialDesign:PackIcon Kind="PlusCircle" Width="18" Height="18" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </materialDesign:Card>

            <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch"
                          Background="Gray" Height="5" />

            <!-- БЛОК 3: Список блюд в меню (ВНИЗУ - равная высота) -->
            <materialDesign:Card Grid.Row="3" Margin="10,5,10,10" Padding="10">
                <DataGrid x:Name="MenuDelicatesDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          IsReadOnly="False"
                          materialDesign:DataGridAssist.CellPadding="10"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="10">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HideInMenu}" Value="True">
                                    <Setter Property="Background" Value="#FFFFF3E0" />
                                    <Setter Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource EditButtonStyle}"
                                            Click="EditDelicateInMenu_Click"
                                            Width="24"
                                            Height="24"
                                            ToolTip="Редактировать блюдо">
                                        <materialDesign:PackIcon Kind="Pencil"
                                                                 Width="14"
                                                                 Height="14" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource DeleteButtonStyle}"
                                            Click="DeleteDelicateFromMenu_Click"
                                            Width="24"
                                            Height="24"
                                            ToolTip="Удалить блюдо">
                                        <materialDesign:PackIcon Kind="Delete"
                                                                 Width="14"
                                                                 Height="14" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="40" Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <materialDesign:PackIcon Kind="AlertCircle"
                                                             Width="16"
                                                             Height="16"
                                                             Foreground="Orange"
                                                             Visibility="{Binding IsModified, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                             ToolTip="Блюдо изменено в этом меню" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Блюдо" Binding="{Binding Del}"
                                            Width="2*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Состав" Binding="{Binding Sost}"
                                            Width="3*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Количество" Binding="{Binding Countpor}"
                                            Width="*" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>
        </Grid>

        <!-- Панель редактирования блюда в меню -->
        <Grid x:Name="EditDelicateInMenuPanel" Grid.RowSpan="2"
              Background="#80000000" Visibility="Collapsed">
            <materialDesign:Card Width="900" MaxHeight="800"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="EditDelicateTitle"
                               Text="Редактирование блюда в меню"
                               Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                               Margin="0,0,0,15" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Название блюда:"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Margin="0,0,0,10" />
                            <TextBlock x:Name="EditDelicateNameText"
                                       Style="{StaticResource MaterialDesignBody1TextBlock}"
                                       Margin="0,0,0,20" />

                            <TextBlock Text="Количество:"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Margin="0,0,0,10" />
                            <TextBox x:Name="EditDelicateCountTextBox"
                                     materialDesign:HintAssist.Hint="Введите количество"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     PreviewTextInput="NumericOnly_PreviewTextInput"
                                     Margin="0,0,0,20" />

                            <TextBlock Text="Состав блюда (можно изменить):"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Margin="0,0,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <GroupBox Grid.Column="0" Header="Доступные продукты" Margin="0,0,10,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBox Grid.Row="0" x:Name="EditProductSearchBox"
                                                 materialDesign:HintAssist.Hint="Поиск..."
                                                 TextChanged="EditProductSearch_TextChanged"
                                                 Margin="0,0,0,5" />
                                        <ListBox Grid.Row="1" x:Name="EditAvailableProductsList"
                                                 DisplayMemberPath="Name"
                                                 SelectionMode="Single"
                                                 MaxHeight="300" />
                                    </Grid>
                                </GroupBox>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                            Click="AddProductToEditDelicate_Click"
                                            Margin="0,0,0,10"
                                            ToolTip="Добавить в состав">
                                        <materialDesign:PackIcon Kind="ArrowRight" />
                                    </Button>
                                    <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                            Click="RemoveProductFromEditDelicate_Click"
                                            ToolTip="Убрать из состава">
                                        <materialDesign:PackIcon Kind="ArrowLeft" />
                                    </Button>
                                </StackPanel>

                                <GroupBox Grid.Column="2" Header="Состав блюда" Margin="10,0,0,0">
                                    <DataGrid x:Name="EditDelicateComponentsGrid"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              materialDesign:DataGridAssist.CellPadding="5"
                                              MaxHeight="300">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Продукт" Binding="{Binding NameT}" Width="*"
                                                                IsReadOnly="True" />
                                            <DataGridTextColumn Header="Вес"
                                                                Binding="{Binding DisplayVes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Width="80" />
                                            <DataGridTextColumn Header="Мера" Binding="{Binding Mera}" Width="60"
                                                                IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </GroupBox>
                            </Grid>

                            <TextBlock
                                Text="⚠️ Внимание: Изменения применяются только к этому меню и не влияют на справочник блюд."
                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                Foreground="Orange"
                                Margin="0,15,0,0"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="❌ Отмена"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Click="CancelEditDelicateInMenu_Click"
                                Margin="0,0,15,0"
                                Padding="30,15"
                                FontSize="15"
                                FontWeight="SemiBold"
                                MinHeight="50"
                                MinWidth="150" />
                        <Button Content="💾 Сохранить изменения"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Click="SaveEditDelicateInMenu_Click"
                                Background="#4CAF50"
                                Padding="30,15"
                                FontSize="15"
                                FontWeight="SemiBold"
                                MinHeight="50"
                                MinWidth="200" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Индикатор загрузки -->
        <Grid x:Name="LoadingOverlay" Grid.RowSpan="2"
              Background="#80000000" Visibility="Collapsed">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         Value="0" IsIndeterminate="True"
                         Width="100" Height="100" />
        </Grid>
    </Grid>
</Page>