<Page x:Class="PaymProdNet9.Pages.MenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:controls="clr-namespace:PaymProdNet9.Controls"
      Loaded="Page_Loaded"
      Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <!-- Стили для кнопок удаления -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="Red" />
            <Setter Property="ToolTip" Value="Удалить" />
        </Style>

        <!-- Стили для кнопок редактирования -->
        <Style x:Key="EditButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="Blue" />
            <Setter Property="ToolTip" Value="Редактировать" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Панель быстрых действий -->
        <materialDesign:Card Grid.Row="0" Margin="10" Padding="10">
            <WrapPanel HorizontalAlignment="Center">
                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="RefreshMenu_Click" Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="Обновить" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="GenerateReport_Click" Margin="5"
                        Background="#FF9800">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileDocument" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="Генерация отчета" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!-- Кнопки печати меню скрыты: достаточно сохранения/отчётов -->
            </WrapPanel>
        </materialDesign:Card>

        <!-- Основной контент -->
        <TabControl Grid.Row="1" x:Name="MainTabControl"
                    Style="{StaticResource MaterialDesignTabControl}"
                    materialDesign:ColorZoneAssist.Mode="PrimaryMid"
                    Margin="10,0,10,10">

            <!-- Вкладка составления меню -->
            <TabItem Header="Составление меню">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="250" />
                    </Grid.RowDefinitions>

                    <!-- Верхняя панель с информацией о банкете -->
                    <materialDesign:Card Grid.Row="0" Margin="10" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" x:Name="BanquetNameTextBox"
                                     materialDesign:HintAssist.Hint="Банкет"
                                     LostFocus="BanquetInfo_LostFocus" Margin="0,0,10,0" />

                            <TextBox Grid.Column="1" x:Name="PeopleCountTextBox"
                                     materialDesign:HintAssist.Hint="Количество"
                                     PreviewTextInput="NumericTextBox_PreviewTextInput"
                                     LostFocus="BanquetInfo_LostFocus" Margin="0,0,10,0" />

                            <controls:DateTimePicker Grid.Column="2" x:Name="BanquetDatePicker"
                                                     SelectedDateTimeChanged="BanquetInfo_Changed" Margin="0,0,10,0" />

                            <TextBox Grid.Column="3" x:Name="DescriptionTextBox"
                                     materialDesign:HintAssist.Hint="Описание"
                                     LostFocus="BanquetInfo_LostFocus" Margin="0,0,10,0" />

                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                        Click="StartMenu_Click"
                                        ToolTip="Перейти к заполнению"
                                        Margin="0,0,5,0">
                                    <materialDesign:PackIcon Kind="PlayCircle" />
                                </Button>
                                <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                        Click="NewMenu_Click"
                                        ToolTip="Новое меню">
                                    <materialDesign:PackIcon Kind="Plus" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Список блюд в меню -->
                    <materialDesign:Card Grid.Row="1" Margin="10" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" x:Name="CurrentMenuInfo"
                                       Text="Выберите или создайте новое меню"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Margin="0,0,0,10" />

                            <DataGrid Grid.Row="1" x:Name="MenuDelicatesDataGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      IsReadOnly="False"
                                      materialDesign:DataGridAssist.CellPadding="10"
                                      materialDesign:DataGridAssist.ColumnHeaderPadding="10">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource DeleteButtonStyle}"
                                                        Click="DeleteDelicateFromMenu_Click">
                                                    <materialDesign:PackIcon Kind="Delete" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Блюдо" Binding="{Binding Del}"
                                                        Width="2*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Состав" Binding="{Binding Sost}"
                                                        Width="3*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Количество" Binding="{Binding Countpor}"
                                                        Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>

                    <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch"
                                  Background="Gray" Height="5" />

                    <!-- Нижняя панель с доступными блюдами -->
                    <materialDesign:Card Grid.Row="3" Margin="10" Padding="10">
                        <Grid x:Name="DelicatesPanel" IsEnabled="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Фильтр по типам блюд -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="AllTypesButton" Content="Все"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Click="FilterDelicates_Click" Tag="%" Margin="0,0,5,0" />
                            </StackPanel>

                            <!-- Список доступных блюд -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="AvailableDelicatesPanel">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <materialDesign:Card Margin="5" Width="280" Height="115"
                                                                 MouseDoubleClick="DelicateCard_MouseDoubleClick">
                                                <Grid Margin="6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" MaxHeight="32" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Text="{Binding Del}"
                                                               FontWeight="Bold" TextWrapping="Wrap"
                                                               FontSize="12"
                                                               MaxHeight="28"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="1" Text="{Binding Sost}"
                                                               TextWrapping="Wrap"
                                                               Opacity="0.7"
                                                               Margin="0,2,0,2"
                                                               FontSize="10"
                                                               MaxHeight="32"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <TextBox Width="55"
                                                                 Height="26"
                                                                 materialDesign:HintAssist.Hint="Кол-во"
                                                                 PreviewTextInput="NumericTextBox_PreviewTextInput"
                                                                 Tag="{Binding}"
                                                                 FontSize="11" />
                                                        <TextBlock VerticalAlignment="Center" Margin="3,0,0,0"
                                                                   Text="{Binding WeightInfo}"
                                                                   FontSize="10" />
                                                    </StackPanel>
                                                </Grid>
                                            </materialDesign:Card>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- Вкладка сохраненных меню -->
            <TabItem Header="Сохраненные меню">
                <materialDesign:Card Margin="10" Padding="10">
                    <DataGrid x:Name="SavedMenusDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              IsReadOnly="True"
                              materialDesign:DataGridAssist.CellPadding="10"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="10">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource DeleteButtonStyle}"
                                                Click="DeleteSavedMenu_Click">
                                            <materialDesign:PackIcon Kind="Delete" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource EditButtonStyle}"
                                                Click="EditSavedMenu_Click">
                                            <materialDesign:PackIcon Kind="Pencil" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Количество людей" Binding="{Binding CountP}" Width="*" />
                            <DataGridTextColumn Header="Дата, время" Binding="{Binding DateBan}" Width="*" />
                            <DataGridTextColumn Header="Доп. информация" Binding="{Binding Detail}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>
            </TabItem>
        </TabControl>

        <!-- Индикатор загрузки -->
        <Grid x:Name="LoadingOverlay" Grid.RowSpan="2"
              Background="#80000000" Visibility="Collapsed">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         Value="0" IsIndeterminate="True"
                         Width="100" Height="100" />
        </Grid>
    </Grid>
</Page>