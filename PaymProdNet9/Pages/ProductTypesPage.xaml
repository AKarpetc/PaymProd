<Page x:Class="PaymProdNet9.Pages.ProductTypesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- РЕЖИМ ПРОСМОТРА СПИСКА -->
        <Grid x:Name="ProductTypesListView" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Кнопка создания и поиск -->
            <materialDesign:Card Grid.Row="0" Margin="10,10,10,5" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="➕ Создать тип продукта"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="8"
                            Background="#4CAF50"
                            BorderBrush="#4CAF50"
                            Foreground="White"
                            Click="NewProductType_Click"
                            Padding="25,15"
                            FontSize="15"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Left"
                            MinHeight="50"
                            ToolTip="Создать новый тип продукта"
                            Margin="0,0,15,0">
                        <Button.Effect>
                            <DropShadowEffect Color="#4CAF50" BlurRadius="8" ShadowDepth="2" Opacity="0.3" />
                        </Button.Effect>
                    </Button>

                    <TextBox Grid.Column="1"
                             x:Name="ProductTypeSearchBox"
                             materialDesign:HintAssist.Hint="Поиск..."
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             VerticalAlignment="Center"
                             FontSize="14"
                             TextChanged="ProductTypeSearch_TextChanged"
                             HorizontalAlignment="Stretch" />
                </Grid>
            </materialDesign:Card>

            <!-- Таблица всех типов продуктов -->
            <materialDesign:Card Grid.Row="1" Margin="10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Все типы продуктов:"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Margin="0,0,0,10" />

                    <DataGrid Grid.Row="1" x:Name="ProductTypesDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              IsReadOnly="True"
                              materialDesign:DataGridAssist.CellPadding="8"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="8"
                              FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="50" Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource DeleteButtonStyle}"
                                                Click="DeleteProductType_Click"
                                                Width="24"
                                                Height="24">
                                            <materialDesign:PackIcon Kind="Delete"
                                                                     Width="14"
                                                                     Height="14" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="50" Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource EditButtonStyle}"
                                                Click="EditProductType_Click"
                                                Width="24"
                                                Height="24">
                                            <materialDesign:PackIcon Kind="Pencil"
                                                                     Width="14"
                                                                     Height="14" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Название типа" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Порядок сортировки" Binding="{Binding SortOrder}" Width="*" />
                            <DataGridTemplateColumn Header="Не показывать в меню" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <materialDesign:PackIcon Kind="EyeOff"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Foreground="#F44336"
                                                                 Visibility="{Binding HideInMenu, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                 ToolTip="Продукты этого типа не отображаются в меню" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- РЕЖИМ СОЗДАНИЯ/РЕДАКТИРОВАНИЯ -->
        <Grid x:Name="ProductTypeEditView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="EditModeTitle"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       Margin="20,10,20,15"
                       Text="Создание типа продукта" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
                <materialDesign:Card Padding="20">
                    <StackPanel>
                        <TextBlock Text="Основная информация"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   Margin="0,0,0,15" />

                        <StackPanel>
                            <TextBlock Text="Название типа продукта:"
                                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                                       Margin="0,0,0,5" />
                            <TextBox x:Name="ProductTypeNameTextBox"
                                     materialDesign:HintAssist.Hint="Например: Овощи, Мясные продукты"
                                     MaxLength="50"
                                     LostFocus="TextField_LostFocus"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />

                            <TextBlock Text="Порядок сортировки:"
                                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                                       Margin="0,15,0,5" />
                            <TextBox x:Name="ProductTypeSortOrderTextBox"
                                     materialDesign:HintAssist.Hint="Число для сортировки (меньше = выше в списке)"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     PreviewTextInput="NumericOnly_PreviewTextInput"
                                     LostFocus="NumericField_LostFocus" />

                            <CheckBox x:Name="ProductTypeHideInMenuCheckBox" Margin="0,15,0,0">
                                <TextBlock
                                    Text="Не показывать продукты этого типа в меню (только в отчете по продуктам)"
                                    TextWrapping="Wrap" />
                            </CheckBox>
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </ScrollViewer>

            <!-- Кнопки действий -->
            <materialDesign:Card Grid.Row="2" Margin="10" Padding="15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="❌ Отмена"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="CancelEdit_Click"
                            Margin="0,0,15,0"
                            Padding="30,15"
                            FontSize="15"
                            FontWeight="SemiBold"
                            MinHeight="50"
                            MinWidth="150"
                            ToolTip="Отменить и вернуться к списку" />
                    <Button x:Name="SaveButton"
                            Content="💾 Создать"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="SaveProductType_Click"
                            Background="#4CAF50"
                            Padding="30,15"
                            FontSize="15"
                            FontWeight="SemiBold"
                            MinHeight="50"
                            MinWidth="180"
                            ToolTip="Сохранить" />
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Page>