<Page x:Class="PaymProdNet9.Pages.PrintMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Loaded="Page_Loaded">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,10">
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#2E7D32"
                    Foreground="White"
                    Padding="20,5"
                    Click="GenerateReportWithPrices_Click">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CashMultiple" Width="20" Height="20" Margin="0,0,10,0" />
                    <TextBlock Text="Отчет с себестоимостью" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#C2185B"
                    Foreground="White"
                    Padding="20,5"
                    Margin="10,0,0,0"
                    Click="GenerateReportWithSalePrices_Click">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="TagTextOutline" Width="20" Height="20" Margin="0,0,10,0" />
                    <TextBlock Text="Отчет с ценой" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#0288D1"
                    Foreground="White"
                    Padding="20,5"
                    Margin="10,0,0,0"
                    Click="GenerateReportWithoutPrices_Click">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="20" Height="20" Margin="0,0,10,0" />
                    <TextBlock Text="Отчет без цен" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="SaveToWordButton"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#4CAF50"
                    Foreground="White"
                    Padding="20,5"
                    Margin="10,0,0,0"
                    Click="SaveToWord_Click"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FileWord" Width="20" Height="20" Margin="0,0,10,0" />
                    <TextBlock Text="Сохранить в Word" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Grid Grid.Row="1">
            <Border HorizontalAlignment="Center"
                    Margin="20,0"
                    MaxWidth="1100"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="6">
                <materialDesign:Card Padding="20" Background="White">
                    <FlowDocumentScrollViewer x:Name="DocumentViewer"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto"
                                              HorizontalAlignment="Center"
                                              MinHeight="600" />
                </materialDesign:Card>
            </Border>
        </Grid>
    </Grid>
</Page>