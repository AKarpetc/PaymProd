<Page x:Class="PaymProdNet9.Pages.DelicatesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Loaded="Page_Loaded">

    <Grid>
        <!-- РЕЖИМ ПРОСМОТРА СПИСКА -->
        <Grid x:Name="ListViewPanel" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Кнопка создания нового блюда и поиск -->
            <materialDesign:Card Grid.Row="0" Margin="10,10,10,5" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="➕ Создать новое блюдо"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="8"
                            Background="#4CAF50"
                            BorderBrush="#4CAF50"
                            Foreground="White"
                            Click="NewDelicate_Click"
                            Padding="25,15"
                            FontSize="15"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Left"
                            MinHeight="50"
                            ToolTip="Создать новое блюдо"
                            Margin="0,0,15,0">
                        <Button.Effect>
                            <DropShadowEffect Color="#4CAF50" BlurRadius="8" ShadowDepth="2" Opacity="0.3" />
                        </Button.Effect>
                    </Button>

                    <!-- Поиск с кнопкой очистки -->
                    <Grid Grid.Column="1">
                        <TextBox x:Name="DelicateSearchBox"
                                 materialDesign:HintAssist.Hint="Поиск..."
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 VerticalAlignment="Center"
                                 FontSize="14"
                                 TextChanged="DelicateSearch_TextChanged"
                                 HorizontalAlignment="Stretch"
                                 Margin="0,0,30,0" />

                        <Button x:Name="DelicateSearchClearButton"
                                Width="22"
                                Height="22"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Click="DelicateSearchClearButton_Click"
                                Visibility="Collapsed"
                                ToolTip="Очистить поиск">
                            <materialDesign:PackIcon Kind="CloseCircle"
                                                     Width="16"
                                                     Height="16"
                                                     Foreground="#B0BEC5" />
                        </Button>
                    </Grid>
                </Grid>
            </materialDesign:Card>

            <!-- Таблица всех блюд -->
            <materialDesign:Card Grid.Row="1" Margin="10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Все блюда:"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Margin="0,0,0,10" />

                    <DataGrid Grid.Row="1" x:Name="DelicatesDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              IsReadOnly="True"
                              materialDesign:DataGridAssist.CellPadding="8"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="8"
                              FontSize="13">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                        <Setter Property="Background" Value="#FFFFCDD2" />
                                        <Setter Property="Foreground" Value="#B71C1C" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="50" Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Button x:Name="DeleteButton"
                                                    Style="{StaticResource DeleteButtonStyle}"
                                                    Click="DeleteDelicate_Click"
                                                    Width="24"
                                                    Height="24"
                                                    ToolTip="Удалить блюдо"
                                                    Visibility="{Binding Id, Converter={StaticResource ProductVisibilityConverter}}">
                                                <materialDesign:PackIcon Kind="Delete"
                                                                         Width="14"
                                                                         Height="14" />
                                            </Button>
                                            <Button x:Name="RestoreButton"
                                                    Style="{StaticResource EditButtonStyle}"
                                                    Click="RestoreDelicate_Click"
                                                    Width="24"
                                                    Height="24"
                                                    ToolTip="Восстановить блюдо"
                                                    Visibility="{Binding Id, Converter={StaticResource ProductVisibilityConverter}}">
                                                <materialDesign:PackIcon Kind="Restore"
                                                                         Width="14"
                                                                         Height="14" />
                                            </Button>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                <Setter TargetName="DeleteButton" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="RestoreButton" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDeleted}" Value="False">
                                                <Setter TargetName="DeleteButton" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="RestoreButton" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="50" Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource EditButtonStyle}"
                                                Click="EditDelicate_Click"
                                                Width="24"
                                                Height="24"
                                                ToolTip="Редактировать блюдо"
                                                Visibility="{Binding Id, Converter={StaticResource ProductVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="Pencil"
                                                                     Width="14"
                                                                     Height="14" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="3*" />
                            <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="*" />
                            <DataGridTextColumn Header="Вес" Binding="{Binding Ves}" Width="*" />
                            <DataGridTextColumn Header="Количество" Binding="{Binding Count}" Width="*" />
                            <DataGridTemplateColumn Header="Авто в меню" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <materialDesign:PackIcon Kind="CheckCircle"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Foreground="#4CAF50"
                                                                 Visibility="{Binding AutoAdd, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Не показывать в меню" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <materialDesign:PackIcon Kind="EyeOff"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Foreground="#F44336"
                                                                 Visibility="{Binding HideInMenu, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                 ToolTip="Блюдо будет отображаться только в отчете по продуктам, но не в отчете меню" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- РЕЖИМ СОЗДАНИЯ/РЕДАКТИРОВАНИЯ -->
        <Grid x:Name="EditViewPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <materialDesign:Card Grid.Row="0" Margin="10" Padding="15">
                <StackPanel>
                    <TextBlock x:Name="EditPanelTitle"
                               Text="Создание нового блюда"
                               Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                               FontWeight="Bold"
                               Foreground="#2196F3" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Форма редактирования -->
            <materialDesign:Card Grid.Row="1" Margin="10" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Основная информация -->
                        <TextBlock Text="Основная информация"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   Margin="0,0,0,15" />

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Название -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,15">
                                <TextBlock Text="Название блюда:"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Margin="0,0,0,5" />
                                <TextBox x:Name="DelicateNameTextBox"
                                         materialDesign:HintAssist.Hint="Введите название блюда"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                            </StackPanel>

                            <!-- Тип -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,15">
                                <TextBlock Text="Тип блюда:"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Margin="0,0,0,5" />
                                <ComboBox x:Name="DelicateTypeComboBox"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="Выберите тип" />
                            </StackPanel>

                            <!-- Вес -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,15">
                                <TextBlock Text="Вес порции (грамм):"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Margin="0,0,0,5" />
                                <TextBox x:Name="DelicateWeightTextBox"
                                         materialDesign:HintAssist.Hint="Например: 250"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         PreviewTextInput="NumericOnly_PreviewTextInput" />
                            </StackPanel>

                            <!-- Количество -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,15">
                                <TextBlock Text="Количество порций:"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Margin="0,0,0,5" />
                                <TextBox x:Name="DelicateCountTextBox"
                                         materialDesign:HintAssist.Hint="По умолчанию: 1"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         PreviewTextInput="NumericOnly_PreviewTextInput" />
                            </StackPanel>

                            <!-- Автодобавление и скрытие в меню -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5,0,0">
                                <CheckBox x:Name="DelicateAutoAddCheckBox" Margin="0,5"
                                          ToolTip="Если отмечено, блюдо будет автоматически добавляться в новое меню с количеством, равным числу гостей.">
                                    <TextBlock Text="Автоматически добавлять в новое меню (количество = число гостей)" TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox x:Name="DelicateHideInMenuCheckBox" Margin="0,5"
                                          ToolTip="Если отмечено, блюдо не выводится в отчете меню, но учитывается в отчете по продуктам.">
                                    <TextBlock Text="Не показывать это блюдо в меню (только в отчете по продуктам)" TextWrapping="Wrap"/>
                                </CheckBox>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,10,0,20" />

                        <!-- Состав блюда -->
                        <TextBlock Text="Состав блюда"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   Margin="0,0,0,15" />

                        <Grid Height="300">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Доступные продукты -->
                            <GroupBox Grid.Column="0" Header="Доступные продукты"
                                      Style="{StaticResource MaterialDesignCardGroupBox}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBox Grid.Row="0" x:Name="ProductSearchBox"
                                             materialDesign:HintAssist.Hint="Поиск..."
                                             TextChanged="ProductSearch_TextChanged"
                                             Margin="0,0,0,5" />

                                    <ListBox Grid.Row="1" x:Name="AvailableProductsList"
                                             DisplayMemberPath="Name"
                                             SelectionMode="Single" />
                                </Grid>
                            </GroupBox>

                            <!-- Кнопки управления -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                        Click="AddProductToDelicate_Click"
                                        Margin="0,0,0,10"
                                        ToolTip="Добавить в состав">
                                    <materialDesign:PackIcon Kind="ArrowRight" />
                                </Button>
                                <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                        Click="RemoveProductFromDelicate_Click"
                                        ToolTip="Убрать из состава">
                                    <materialDesign:PackIcon Kind="ArrowLeft" />
                                </Button>
                            </StackPanel>

                            <!-- Состав блюда -->
                            <GroupBox Grid.Column="2" Header="Состав блюда"
                                      Style="{StaticResource MaterialDesignCardGroupBox}">
                                <DataGrid x:Name="DelicateComponentsGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="False"
                                          materialDesign:DataGridAssist.CellPadding="5">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Продукт" Binding="{Binding NameT}"
                                                            Width="*" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Вес" Binding="{Binding Ves, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="80" />
                                        <DataGridTextColumn Header="Мера" Binding="{Binding Mera}"
                                                            Width="60" IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>

            <!-- Кнопки действий -->
            <materialDesign:Card Grid.Row="2" Margin="10" Padding="15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="❌ Отмена"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="CancelEdit_Click"
                            Margin="0,0,15,0"
                            Padding="30,15"
                            FontSize="15"
                            FontWeight="SemiBold"
                            MinHeight="50"
                            MinWidth="150"
                            ToolTip="Отменить и вернуться к списку" />
                    <Button x:Name="SaveButton"
                            Content="💾 Создать блюдо"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="SaveDelicate_Click"
                            Background="#4CAF50"
                            Padding="30,15"
                            FontSize="15"
                            FontWeight="SemiBold"
                            MinHeight="50"
                            MinWidth="180"
                            ToolTip="Сохранить блюдо" />
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Page>