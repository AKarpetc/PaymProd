<Page x:Class="PaymProdNet9.Pages.EditMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:controls="clr-namespace:PaymProdNet9.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Редактирование меню"
      AutomationProperties.AutomationId="EditMenuPage">

    <Grid>
        <!-- Center content similarly to a dialog -->
        <materialDesign:Card Padding="20" 
                             Width="400" 
                             VerticalAlignment="Center" 
                             HorizontalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Редактирование меню"
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Margin="0,0,0,20" />

                <StackPanel Grid.Row="1">
                    <TextBox x:Name="NameTextBox"
                             materialDesign:HintAssist.Hint="Название банкета"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             Margin="0,0,0,15"
                             AutomationProperties.AutomationId="BanquetNameTextBox" />

                    <TextBox x:Name="GuestsTextBox"
                             materialDesign:HintAssist.Hint="Количество гостей"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             PreviewTextInput="GuestsTextBox_PreviewTextInput"
                             Margin="0,0,0,15"
                             AutomationProperties.AutomationId="PeopleCountTextBox" />

                    <controls:DateTimePicker x:Name="DatePicker"
                                             Margin="0,0,0,15"
                                             AutomationProperties.AutomationId="BanquetDatePicker" />

                    <TextBox x:Name="DescriptionTextBox"
                             materialDesign:HintAssist.Hint="Описание (необязательно)"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="60"
                             Margin="0,0,0,15"
                             AutomationProperties.AutomationId="DescriptionTextBox" />
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Content="Отмена"
                            Click="Cancel_Click"
                            Margin="0,0,10,0" />
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Content="Сохранить"
                            Click="Save_Click"
                            IsDefault="True"
                            AutomationProperties.AutomationId="SaveMenuButton" />
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Page>
