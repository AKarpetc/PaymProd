<Page x:Class="PaymProdNet9.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- РЕЖИМ ПРОСМОТРА СПИСКА -->
        <Grid x:Name="ProductsListView" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Кнопка создания нового продукта и поиск -->
            <materialDesign:Card Grid.Row="0" Margin="10,10,10,5" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="➕ Создать новый продукт"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="8"
                            Background="#4CAF50"
                            BorderBrush="#4CAF50"
                            Foreground="White"
                            Click="NewProduct_Click"
                            Padding="25,15"
                            FontSize="15"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Left"
                            MinHeight="50"
                            ToolTip="Создать новый продукт"
                            Margin="0,0,15,0">
                        <Button.Effect>
                            <DropShadowEffect Color="#4CAF50" BlurRadius="8" ShadowDepth="2" Opacity="0.3" />
                        </Button.Effect>
                    </Button>

                    <!-- Поиск с кнопкой очистки -->
                    <Grid Grid.Column="1">
                        <TextBox x:Name="ProductSearchBox"
                                 materialDesign:HintAssist.Hint="Поиск..."
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 VerticalAlignment="Center"
                                 FontSize="14"
                                 TextChanged="ProductSearch_TextChanged"
                                 HorizontalAlignment="Stretch"
                                 Margin="0,0,30,0" />

                        <Button x:Name="ProductSearchClearButton"
                                Width="22"
                                Height="22"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Click="ProductSearchClearButton_Click"
                                Visibility="Collapsed"
                                ToolTip="Очистить поиск">
                            <materialDesign:PackIcon Kind="CloseCircle"
                                                     Width="16"
                                                     Height="16"
                                                     Foreground="#B0BEC5" />
                        </Button>
                    </Grid>
                </Grid>
            </materialDesign:Card>

            <!-- Таблица всех продуктов -->
            <materialDesign:Card Grid.Row="1" Margin="10" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Все продукты:"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Margin="0,0,0,10" />

                    <DataGrid Grid.Row="1" x:Name="ProductsDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              IsReadOnly="True"
                              materialDesign:DataGridAssist.CellPadding="8"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="8"
                              FontSize="13">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                        <Setter Property="Background" Value="#FFFFCDD2" />
                                        <Setter Property="Foreground" Value="#B71C1C" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="50" Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Button x:Name="DeleteButton"
                                                    Style="{StaticResource DeleteButtonStyle}"
                                                    Click="DeleteProduct_Click"
                                                    Width="24"
                                                    Height="24"
                                                    ToolTip="Удалить продукт">
                                                <materialDesign:PackIcon Kind="Delete"
                                                                         Width="14"
                                                                         Height="14" />
                                            </Button>
                                            <Button x:Name="RestoreButton"
                                                    Style="{StaticResource EditButtonStyle}"
                                                    Click="RestoreProduct_Click"
                                                    Width="24"
                                                    Height="24"
                                                    ToolTip="Восстановить продукт"
                                                    Visibility="Collapsed">
                                                <materialDesign:PackIcon Kind="Restore"
                                                                         Width="14"
                                                                         Height="14" />
                                            </Button>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                <Setter TargetName="DeleteButton" Property="Visibility"
                                                        Value="Collapsed" />
                                                <Setter TargetName="RestoreButton" Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDeleted}" Value="False">
                                                <Setter TargetName="DeleteButton" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="RestoreButton" Property="Visibility"
                                                        Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="50" Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource EditButtonStyle}"
                                                Click="EditProduct_Click"
                                                Width="24"
                                                Height="24"
                                                ToolTip="Редактировать продукт">
                                            <materialDesign:PackIcon Kind="Pencil"
                                                                     Width="14"
                                                                     Height="14" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="*" />
                            <DataGridTextColumn Header="Вес/Количество" Binding="{Binding Count}" Width="*" />
                            <DataGridTextColumn Header="Ед. (основная)" Binding="{Binding Ves}" Width="*" />
                            <DataGridTextColumn Header="Фасовка" Binding="{Binding Fass}" Width="*" />
                            <DataGridTextColumn Header="Ед. (фасовка)" Binding="{Binding IzName}" Width="*" />
                            <!-- Поле "Кол-во людей" скрыто - не используется в текущей логике -->
                            <!-- <DataGridTextColumn Header="Кол-во людей" Binding="{Binding CountPeople}" Width="*" /> -->
                            <DataGridTextColumn Header="Цена, тг" Binding="{Binding Price}" Width="*" />

                            <DataGridTemplateColumn Header="В блюда" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <materialDesign:PackIcon Kind="CheckCircle"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Foreground="#4CAF50"
                                                                 Visibility="{Binding PrizMen1, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Авто в отчет" Width="*">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    ToolTip="Автоматически добавляется в отчет по товарам">
                                            <TextBlock Text="Авто в отчет" />
                                            <materialDesign:PackIcon Kind="Information"
                                                                     Width="14"
                                                                     Height="14"
                                                                     Foreground="#2196F3"
                                                                     Margin="3,0,0,0"
                                                                     VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="CheckCircle"
                                                                     Width="18"
                                                                     Height="18"
                                                                     Foreground="#4CAF50"
                                                                     Visibility="{Binding AutoAdd, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                     ToolTip="Автоматически добавляется в отчет по товарам" />
                                            <TextBlock Text="✓"
                                                       Foreground="#4CAF50"
                                                       FontWeight="Bold"
                                                       Visibility="{Binding AutoAdd, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       ToolTip="Автоматически добавляется в отчет по товарам"
                                                       Margin="3,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Общее" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <materialDesign:PackIcon Kind="FormatListNumbered"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Foreground="#4CAF50"
                                                                 Visibility="{Binding MainCount, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Не показывать в меню" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <materialDesign:PackIcon Kind="EyeOff"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Foreground="#F44336"
                                                                 Visibility="{Binding HideInMenu, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                 ToolTip="Продукт будет отображаться только в отчете по продуктам, но не в отчете меню" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Без фасовки (в меню)" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Foreground="#FF9800"
                                                                 Visibility="{Binding DoNotConvertToPackInMenu, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                 ToolTip="Если включено, в отчете по меню не переводить в фасовку" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- РЕЖИМ СОЗДАНИЯ/РЕДАКТИРОВАНИЯ -->
        <Grid x:Name="ProductEditView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="EditModeTitle"
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       Margin="20,10,20,15"
                       Text="Создание нового продукта" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
                <materialDesign:Card Padding="20">
                    <StackPanel>
                        <!-- Форма редактирования продукта -->
                        <TextBlock Text="Основная информация"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   Margin="0,0,0,15" />

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="Название продукта:"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Margin="0,0,0,5" />
                                <TextBox x:Name="ProductNameTextBox"
                                         materialDesign:HintAssist.Hint="Введите название продукта"
                                         MaxLength="50"
                                         LostFocus="TextField_LostFocus"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="5,0,5,10">
                                <TextBlock Text="Тип продукта:"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Margin="0,0,0,5" />
                                <ComboBox x:Name="ProductTypeComboBox"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="Выберите тип" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="10,0,0,10">
                                <TextBlock Text="Единица измерения (основная):"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Margin="0,0,0,5" />
                                <ComboBox x:Name="ProductMeasureComboBox"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectionChanged="ProductMeasureComboBox_SelectionChanged"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="Выберите меру" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="Вес/Количество:"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Margin="0,0,0,5" />
                                <TextBox x:Name="ProductCountTextBox"
                                         materialDesign:HintAssist.Hint="Например: 100"
                                         PreviewTextInput="NumericOnly_PreviewTextInput"
                                         LostFocus="NumericField_LostFocus"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,0,5,10">
                                <TextBlock Text="Фасовка (значение):"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Margin="0,0,0,5" />
                                <TextBox x:Name="ProductFassTextBox"
                                         materialDesign:HintAssist.Hint="Например: 1"
                                         PreviewTextInput="NumericOnly_PreviewTextInput"
                                         LostFocus="NumericField_LostFocus"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="10,0,0,10">
                                <TextBlock Text="Единица измерения (фасовка):"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Margin="0,0,0,5" />
                                <ComboBox x:Name="ProductFassMeasureComboBox"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="Выберите меру" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="Цена (тг за фасовку):"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Margin="0,0,0,5" />
                                <TextBox x:Name="ProductPriceTextBox"
                                         materialDesign:HintAssist.Hint="Например: 1500"
                                         PreviewTextInput="NumericOnly_PreviewTextInput"
                                         LostFocus="NumericField_LostFocus"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                            </StackPanel>

                            <!-- Поле "Количество людей" скрыто - не используется в текущей логике -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,10,10,0" Visibility="Collapsed">
                                <TextBlock Text="Количество людей:"
                                           Style="{StaticResource MaterialDesignBody2TextBlock}"
                                           Margin="0,0,0,5" />
                                <TextBox x:Name="ProductCountPeopleTextBox"
                                         materialDesign:HintAssist.Hint="Например: 10"
                                         PreviewTextInput="NumericOnly_PreviewTextInput"
                                         LostFocus="NumericField_LostFocus"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Width="200"
                                         HorizontalAlignment="Left" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                <CheckBox x:Name="ProductAddToDishesCheckBox" Margin="0,5">
                                    <TextBlock Text="Добавить в блюда" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox x:Name="ProductAutoAddCheckBox" Margin="0,5"
                                          ToolTip="Если отмечено, продукт автоматически добавляется в отчет по товарам в раздел 'Хозтовары' при генерации отчета для текущего меню">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Автоматически добавлять в отчет" TextWrapping="Wrap"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox x:Name="ProductMainCountCheckBox" Margin="0,5">
                                    <TextBlock Text="Общее количество (не по граммовке, а общее число на весь банкет)"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox x:Name="ProductHideInMenuCheckBox" Margin="0,5"
                                          ToolTip="Если отмечено, продукт не выводится в отчете меню, но учитывается в отчете по продуктам">
                                    <TextBlock Text="Не показывать этот продукт в меню (только в отчете по продуктам)"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox x:Name="ProductDoNotConvertToPackInMenuCheckBox" Margin="0,5"
                                          ToolTip="Если отмечено, в отчете по меню продукт будет показан в основной единице, без пересчета в фасовку">
                                    <TextBlock Text="Не переводить в фасованные в меню (отчет по меню)"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox x:Name="ProductRoundToIntegerCheckBox" Margin="0,5"
                                          ToolTip="Если отмечено, при расчете количества упаковок/штук значение округляется до целого числа (в большую сторону по модулю)">
                                    <TextBlock Text="Округлять количество до целого числа (в отчетах)"
                                               TextWrapping="Wrap" />
                                </CheckBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>
            </ScrollViewer>

            <!-- Кнопки действий -->
            <materialDesign:Card Grid.Row="2" Margin="10" Padding="15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="❌ Отмена"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="CancelEdit_Click"
                            Margin="0,0,15,0"
                            Padding="30,15"
                            FontSize="15"
                            FontWeight="SemiBold"
                            MinHeight="50"
                            MinWidth="150"
                            ToolTip="Отменить и вернуться к списку" />
                    <Button x:Name="SaveButton"
                            Content="💾 Создать продукт"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Click="SaveProduct_Click"
                            Background="#4CAF50"
                            Padding="30,15"
                            FontSize="15"
                            FontWeight="SemiBold"
                            MinHeight="50"
                            MinWidth="180"
                            ToolTip="Сохранить продукт" />
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Page>