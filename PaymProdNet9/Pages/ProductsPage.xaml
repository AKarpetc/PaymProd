<Page x:Class="PaymProdNet9.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" 
                    Background="Gray" Height="5"/>

        <!-- Верхняя часть - список продуктов -->
        <materialDesign:Card Grid.Row="0" Margin="10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Все продукты:" 
                         Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                         Margin="0,0,0,10"/>

                <DataGrid Grid.Row="1" x:Name="ProductsDataGrid" 
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        SelectionMode="Single"
                        IsReadOnly="True"
                        SelectionChanged="ProductsDataGrid_SelectionChanged"
                        materialDesign:DataGridAssist.CellPadding="10">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource MaterialDesignIconButton}"
                                          Click="DeleteProduct_Click" Foreground="Red">
                                        <materialDesign:PackIcon Kind="Delete"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="*"/>
                        <DataGridTextColumn Header="Единица измерения" Binding="{Binding Measure}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>

        <!-- Нижняя часть - редактирование продукта -->
        <materialDesign:Card Grid.Row="2" Margin="10" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                         Text="Создайте новый продукт или выберите существующий для редактирования"
                         Style="{StaticResource MaterialDesignBody2TextBlock}"
                         Margin="0,0,0,15"/>

                <!-- Кнопка создания нового продукта -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="➕ Создать новый продукт" 
                          Style="{StaticResource MaterialDesignRaisedButton}"
                          materialDesign:ButtonAssist.CornerRadius="10"
                          Background="#4CAF50"
                          BorderBrush="#4CAF50"
                          Foreground="White"
                          Click="NewProduct_Click"
                          Padding="20,10"
                          FontWeight="SemiBold"
                          ToolTip="Создать новый продукт"/>
                </StackPanel>

                <!-- Панель редактирования продукта -->
                <Grid Grid.Row="2" x:Name="ProductEditPanel" IsEnabled="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Название продукта:" 
                                 Style="{StaticResource MaterialDesignBody2TextBlock}"
                                 Margin="0,0,0,5"/>
                        <TextBox x:Name="ProductNameTextBox" 
                               materialDesign:HintAssist.Hint="Введите название продукта"
                               Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0">
                        <TextBlock Text="Тип продукта:" 
                                 Style="{StaticResource MaterialDesignBody2TextBlock}"
                                 Margin="0,0,0,5"/>
                        <ComboBox x:Name="ProductTypeComboBox" 
                                DisplayMemberPath="Name"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                materialDesign:HintAssist.Hint="Выберите тип"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                        <TextBlock Text="Единица измерения:" 
                                 Style="{StaticResource MaterialDesignBody2TextBlock}"
                                 Margin="0,0,0,5"/>
                        <ComboBox x:Name="ProductMeasureComboBox" 
                                DisplayMemberPath="Name"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                materialDesign:HintAssist.Hint="Выберите меру"/>
                    </StackPanel>
                </Grid>

                <!-- Кнопки действий -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="💾 Сохранить продукт" 
                          Style="{StaticResource MaterialDesignRaisedButton}"
                          Click="UpdateProduct_Click"
                          ToolTip="Сохранить изменения продукта"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Page>

