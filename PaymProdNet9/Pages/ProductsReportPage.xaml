<Page x:Class="PaymProdNet9.Pages.ProductsReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Меню -->
        <Menu Grid.Row="0">
            <MenuItem Header="Документ">
                <MenuItem Header="Сохранить в Word" Click="SaveToWord_Click">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="FileWord" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Печать" Click="Print_Click">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="Printer" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Отчет по продуктам -->
        <materialDesign:Card Grid.Row="1" Margin="10" Padding="20">
            <FlowDocumentScrollViewer>
                <FlowDocument x:Name="ReportDocument">
                    <Paragraph x:Name="HeaderParagraph" TextAlignment="Center" FontSize="16" FontWeight="Bold" />
                    <Table x:Name="ReportTable" CellSpacing="1" BorderBrush="Black" BorderThickness="1">
                        <Table.Columns>
                            <TableColumn Width="3*" />
                            <TableColumn Width="1*" />
                        </Table.Columns>
                    </Table>
                </FlowDocument>
            </FlowDocumentScrollViewer>
        </materialDesign:Card>
    </Grid>
</Page>