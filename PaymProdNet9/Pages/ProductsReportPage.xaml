<Page x:Class="PaymProdNet9.Pages.ProductsReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="10"
                    HorizontalAlignment="Left">
            <Button Click="SaveToWord_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Padding="20,8"
                    Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="FileWord" Margin="0,0,8,0"/>
                    <TextBlock Text="Сохранить в Word" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Click="Print_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Padding="20,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Printer" Margin="0,0,8,0"/>
                    <TextBlock Text="Печать" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Отчет по продуктам -->
        <materialDesign:Card Grid.Row="1" Margin="10" Padding="20">
            <FlowDocumentScrollViewer>
                <FlowDocument x:Name="ReportDocument">
                    <Paragraph x:Name="HeaderParagraph" TextAlignment="Center" FontSize="16" FontWeight="Bold" />
                    <Table x:Name="ReportTable" CellSpacing="1" BorderBrush="Black" BorderThickness="1">
                        <Table.Columns>
                            <TableColumn Width="3*" />
                            <TableColumn Width="1*" />
                        </Table.Columns>
                    </Table>
                </FlowDocument>
            </FlowDocumentScrollViewer>
        </materialDesign:Card>
    </Grid>
</Page>