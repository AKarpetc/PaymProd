<Page x:Class="PaymProdNet9.Pages.ProductsReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="10"
                    HorizontalAlignment="Left">
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Padding="20,8"
                    Click="GenerateMultiMenuReport_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="FileDocumentMultiple" Margin="0,0,8,0" />
                    <TextBlock Text="Печать нескольких меню" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Padding="20,8"
                    Margin="10,0,0,0"
                    Click="GenerateReportWithPrices_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CashMultiple" Margin="0,0,8,0" />
                    <TextBlock Text="Текущий с ценами" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Padding="20,8"
                    Margin="10,0,0,0"
                    Click="GenerateReportWithoutPrices_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="FileDocumentOutline" Margin="0,0,8,0" />
                    <TextBlock Text="Текущий без цен" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="SaveToWordButton"
                    Visibility="Collapsed"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Padding="20,8"
                    Margin="20,0,0,0"
                    Click="SaveToWord_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="FileWord" Margin="0,0,8,0" />
                    <TextBlock Text="Сохранить в Word" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Отчет по товарам -->
        <materialDesign:Card Grid.Row="1" Margin="10" Padding="20">
            <FlowDocumentScrollViewer>
                <FlowDocument x:Name="ReportDocument" />
            </FlowDocumentScrollViewer>
        </materialDesign:Card>
    </Grid>
</Page>