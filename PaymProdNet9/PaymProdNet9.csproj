<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <ApplicationIcon>Resources\Restaurant_Blue_2.ico</ApplicationIcon>
        <AssemblyName>PaymProdNet9</AssemblyName>
        <RootNamespace>PaymProdNet9</RootNamespace>
        <Version>3.2.3</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MaterialDesignThemes" Version="5.1.0"/>
        <PackageReference Include="MaterialDesignColors" Version="3.1.0"/>
        <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2"/>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0"/>
        <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1"/>
        <PackageReference Include="ClosedXML" Version="0.104.2"/>
        <PackageReference Include="System.Data.SqlClient" Version="4.9.0"/>
        <PackageReference Include="System.Data.SQLite" Version="1.0.119"/>
        <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.4"/>
        <PackageReference Include="AWSSDK.S3" Version="3.7.305.24"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="Resources\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="s3settings.local.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Update="app.config">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>

